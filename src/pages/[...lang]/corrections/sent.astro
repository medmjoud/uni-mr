---
import { CircleCheck } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import { langParams, localePath, toLocale, useTranslations } from '@/i18n'

export function getStaticPaths() {
  return langParams().map((params) => ({ params }))
}

const lang = toLocale(Astro.params.lang)
const { t } = useTranslations(lang)
---

<Layout lang={lang} title={t('corr.sentTitle')} description={t('corr.sentText')}>
  <div class="wrap py-16 md:py-24">
    <div class="card sent">
      <CircleCheck class="check" aria-hidden="true" />
      <h1 class="display mt-4 text-3xl md:text-4xl">{t('corr.sentTitle')}</h1>
      <p class="mt-3 text-[1.05rem] text-muted">{t('corr.sentText')}</p>
      <a class="btn btn-primary mt-8" href={localePath(lang, '/')} data-back data-back-label={t('corr.back')}>
        {t('corr.home')}
      </a>
    </div>
  </div>
</Layout>

<style>
  .sent {
    max-width: 36rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .check {
    width: 3rem;
    height: 3rem;
    color: var(--emerald-700);
  }
</style>

<script>
  // Send the reader back to the page they were reporting on, when the link carried one.
  const back = document.querySelector<HTMLAnchorElement>('[data-back]')
  const page = new URLSearchParams(location.search).get('page') ?? ''
  if (back && /^\/(?!\/)/.test(page)) {
    back.href = page
    back.textContent = back.dataset.backLabel ?? back.textContent
  }
</script>
