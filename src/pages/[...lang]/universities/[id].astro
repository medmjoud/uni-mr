---
import { ArrowLeft, ExternalLink, MapPin, CalendarDays, Users, Languages, Landmark, Mail, Phone, BookOpen } from '@lucide/astro'
import { getImage, Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import InstitutionMark from '@/components/InstitutionMark.astro'
import LocationMap from '@/components/LocationMap.astro'
import ShareWhatsApp from '@/components/ShareWhatsApp.astro'
import KeyDateList from '@/components/KeyDateList.astro'
import { upcomingFor } from '@/lib/calendar'
import { getInstitutions, hostname, localized, related, type Institution } from '@/lib/institutions'
import { logoFor, photoFor } from '@/lib/media'
import { correctionHref } from '@/lib/site'
import { langParams, localePath, toLocale, useTranslations } from '@/i18n'

export async function getStaticPaths() {
  const all = await getInstitutions()
  return langParams().flatMap(({ lang }) =>
    all.map((entry) => ({ params: { lang, id: entry.id }, props: { entry, all } })),
  )
}

interface Props {
  entry: Institution
  all: Institution[]
}

const { entry, all } = Astro.props
const lang = toLocale(Astro.params.lang)
const { t, term, city, num, list } = useTranslations(lang)
const d = entry.data
const text = localized(entry, lang)
const nearby = related(entry, all)
const dates = upcomingFor(entry, lang)

const primary = lang === 'ar' && d.nameAr ? d.nameAr : d.name
const secondary = lang === 'ar' ? (d.nameAr ? d.name : null) : d.nameAr
const typeLabel = list([t(`type.${d.type}`), t(`cat.${d.category}`)])
const logo = logoFor(entry.id)
const photo = photoFor(entry.id, lang)
const absolute = async (image: ImageMetadata, width: number, format: 'png' | 'jpg') =>
  new URL((await getImage({ src: image, width, format })).src, Astro.site).href
const description = `${primary}${d.acronym ? ` (${d.acronym})` : ''}: ${list([typeLabel, city(d.city)])}. ${text.summary}`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': d.category === 'university' ? 'CollegeOrUniversity' : 'EducationalOrganization',
  name: d.name,
  alternateName: [d.nameAr, d.nameEn, d.acronym].filter(Boolean),
  description: text.summary,
  url: d.website ?? undefined,
  foundingDate: d.founded ? String(d.founded) : undefined,
  email: d.email ?? undefined,
  telephone: d.phone ?? undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: d.city,
    addressRegion: d.wilaya ?? undefined,
    addressCountry: 'MR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: d.coordinates[0], longitude: d.coordinates[1] },
  sameAs: [d.wikipedia, d.wikidata && `https://www.wikidata.org/wiki/${d.wikidata}`].filter(Boolean),
  logo: logo ? await absolute(logo.image, 256, 'png') : undefined,
  image: photo ? await absolute(photo.image, 1200, 'jpg') : undefined,
}

const facts = [
  { icon: Landmark, label: t('profile.factType'), value: typeLabel },
  { icon: MapPin, label: t('profile.factLocation'), value: list([city(d.city), d.wilaya]) },
  { icon: CalendarDays, label: t('profile.factFounded'), value: d.founded ? String(d.founded) : null },
  {
    icon: Users,
    label: t('profile.factStudents'),
    value: d.studentCount ? `${num(d.studentCount)}${d.studentCountYear ? ` (${d.studentCountYear})` : ''}` : null,
  },
  { icon: Languages, label: t('profile.factLanguages'), value: d.languages.length ? list(d.languages.map(term)) : null },
]
---

<Layout lang={lang} title={d.acronym ? `${primary} (${d.acronym})` : primary} description={description} jsonLd={jsonLd}>
  <header class="page-band">
    <div class="wrap py-10 md:py-14">
      <a href={localePath(lang, '/#directory')} class="back">
        <ArrowLeft class="icon flip-rtl" aria-hidden="true" />
        {t('profile.back')}
      </a>
      <div class="head">
        <InstitutionMark entry={entry} size="lg" />
        <div class="min-w-0">
          <div class="flex flex-wrap gap-2">
            <span class="chip chip-gold">{t(`type.${d.type}`)}</span>
            <span class="chip">{t(`cat.${d.category}`)}</span>
          </div>
          <h1 class="display profile-title">{primary}</h1>
          {
            secondary && (
              <p class="profile-alt alt-script" lang={lang === 'ar' ? 'fr' : 'ar'} dir={lang === 'ar' ? 'ltr' : 'rtl'}>
                {secondary}
              </p>
            )
          }
          <div class="mt-5">
            <ShareWhatsApp lang={lang} text={t('share.institution', { name: d.acronym ? `${primary} (${d.acronym})` : primary, city: city(d.city) })} />
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="wrap profile-grid">
    <article class="profile-main">
      {
        photo && (
          <figure class="card photo">
            <Image src={photo.image} alt={photo.caption} widths={[640, 960, 1280]} sizes="(min-width: 980px) 720px, 100vw" />
            <figcaption>
              {photo.caption}. {t('media.photo')}: <a href={photo.source}>{photo.author}</a>,{' '}
              <a href={photo.licenseUrl} rel="license">{photo.license}</a>
            </figcaption>
          </figure>
        )
      }
      <section class="card p-6 md:p-8">
        <p class="lede measure">{text.summary}</p>
        {
          text.highlights.length > 0 && (
            <>
              <h2 class="section-title mt-8">{t('profile.highlights')}</h2>
              <ul class="bullets measure">
                {text.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </>
          )
        }
        {lang !== 'en' && text.translated && <p class="note">{t('profile.translationNote')}</p>}
      </section>

      {
        d.faculties.length > 0 && (
          <section class="card p-6 md:p-8" aria-labelledby="faculties">
            <h2 id="faculties" class="section-title">{t('profile.faculties')}</h2>
            <ul class="faculty-list" lang="fr" dir="ltr">
              {d.faculties.map((f) => (
                <li>
                  <BookOpen class="icon" aria-hidden="true" />
                  {f}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="card p-6 md:p-8" aria-labelledby="study">
        <h2 id="study" class="section-title">{t('profile.study')}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {d.fields.map((f) => <li><a class="tag" href={`${localePath(lang, '/')}?field=${encodeURIComponent(f)}#directory`}>{term(f)}</a></li>)}
        </ul>
        {
          d.degrees.length > 0 && (
            <>
              <h3 class="sub-title">{t('profile.degrees')}</h3>
              <ul class="flex flex-wrap gap-2">
                {d.degrees.map((g) => <li class="tag tag-gold">{term(g)}</li>)}
              </ul>
            </>
          )
        }
      </section>

      {
        text.admission && (
          <section class="card p-6 md:p-8" aria-labelledby="admission">
            <h2 id="admission" class="section-title">{t('profile.admission')}</h2>
            <p class="mt-3 measure">{text.admission}</p>
            <a class="link mt-4 inline-block" href={localePath(lang, '/admissions/')}>{t('profile.seeGuide')}</a>
          </section>
        )
      }

      {
        dates.length > 0 && (
          <section class="card p-6 md:p-8 key-dates" aria-labelledby="key-dates">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 id="key-dates" class="section-title">{t('cal.title')}</h2>
              <a class="link text-sm" href={localePath(lang, '/calendar/')}>{t('cal.all')}</a>
            </div>
            <KeyDateList events={dates} lang={lang} list="upcoming" variant="compact" limit={3} />
          </section>
        )
      }

      <section class="card p-6 md:p-8" aria-labelledby="sources">
        <h2 id="sources" class="section-title">{t('common.sources')}</h2>
        <ol class="sources">
          {d.sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
          {logo && <li>{t('media.logo')}: <a href={logo.source}>{hostname(logo.source)}</a></li>}
        </ol>
        <p class="mt-5 text-sm text-muted">
          {t('profile.outdated')}{' '}
          <a class="link" href={correctionHref(lang, Astro.url.pathname, d.name)}>{t('footer.report')}</a>
        </p>
      </section>
    </article>

    <aside class="profile-aside">
      <div class="card p-5">
        {
          d.website && (
            <a class="btn btn-primary w-full" href={d.website} rel="noopener">
              {t('profile.visit', { host: hostname(d.website) })}
              <ExternalLink class="icon" aria-hidden="true" />
            </a>
          )
        }
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt><f.icon class="icon" aria-hidden="true" />{f.label}</dt>
              <dd class:list={{ missing: !f.value }}>{f.value ?? t('common.notPublished')}</dd>
            </div>
          ))}
          {d.email && <div><dt><Mail class="icon" aria-hidden="true" />{t('profile.factEmail')}</dt><dd><a class="link" href={`mailto:${d.email}`} dir="ltr">{d.email}</a></dd></div>}
          {d.phone && <div><dt><Phone class="icon" aria-hidden="true" />{t('profile.factPhone')}</dt><dd><a class="link" href={`tel:${d.phone.replace(/\s/g, '')}`} dir="ltr">{d.phone}</a></dd></div>}
          {d.wikipedia && <div><dt><BookOpen class="icon" aria-hidden="true" />{t('profile.factWiki')}</dt><dd><a class="link" href={d.wikipedia}>{t('profile.wikiLink')}</a></dd></div>}
        </dl>
      </div>

      <div class="card p-3">
        <LocationMap name={d.name} coordinates={d.coordinates} precision={d.coordinatesPrecision} lang={lang} />
      </div>
    </aside>
  </div>

  {
    nearby.length > 0 && (
      <section class="wrap pb-20" aria-labelledby="related">
        <h2 id="related" class="headline text-2xl">{t('profile.related')}</h2>
        <ul class="related">
          {nearby.map((r) => (
            <li>
              <a class="card related-card" href={localePath(lang, `/universities/${r.id}/`)}>
                <InstitutionMark entry={r} size="sm" />
                <span class="min-w-0">
                  <span class="related-name">{lang === 'ar' && r.data.nameAr ? r.data.nameAr : r.data.name}</span>
                  <span class="text-muted text-sm">{city(r.data.city)}, {t(`type.${r.data.type}`)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .head {
    margin-top: 1.75rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  @media (max-width: 560px) {
    .head {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .chip {
    border-radius: 999px;
    border: 1.5px solid var(--emerald-700);
    padding: 0.15rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--emerald-700);
  }

  .chip-gold {
    border-color: transparent;
    background: var(--emerald-700);
    color: #fff;
  }

  .profile-title {
    margin-top: 0.9rem;
    max-width: 24ch;
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
  }

  .profile-alt {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--muted);
  }

  .profile-grid {
    display: grid;
    /* minmax(0, …) stops long source links from stretching the column past the screen. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.5rem 3rem;
  }

  @media (min-width: 980px) {
    .profile-grid {
      grid-template-columns: minmax(0, 1fr) 22.5rem;
      gap: 1.5rem;
      margin-top: -2.5rem;
      position: relative;
    }
    .profile-aside {
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
  }

  .profile-main {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .photo {
    overflow: hidden;
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .photo img {
      aspect-ratio: 16 / 9;
    }
  }

  .photo figcaption {
    padding: 0.75rem 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .photo figcaption a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--text);
  }

  .bullets {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.6rem;
  }

  .bullets li {
    position: relative;
    padding-inline-start: 1.4rem;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.1rem;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--emerald-600);
    rotate: 45deg;
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .faculty-list {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .faculty-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .faculty-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 0.7rem 0.85rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .faculty-list :global(.icon) {
    margin-top: 0.15rem;
    color: var(--emerald-600);
  }

  .sub-title {
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .sources {
    margin-top: 1rem;
    display: grid;
    gap: 0.55rem;
    padding-inline-start: 1.3rem;
    list-style: decimal;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .sources li::marker {
    color: var(--muted);
  }

  .sources a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .sources a:hover {
    color: var(--emerald-700);
    text-decoration-color: currentColor;
  }

  .key-dates :global(.kd-list) {
    margin-top: 0.5rem;
    gap: 0;
  }

  .key-dates :global(.kd) {
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 0.9rem 0;
    box-shadow: none;
  }

  .key-dates :global(.kd:last-child) {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .profile-aside {
    display: grid;
    gap: 1.25rem;
  }

  .facts {
    margin-top: 0.75rem;
  }

  .facts div {
    display: grid;
    gap: 0.15rem;
    border-bottom: 1px solid var(--line);
    padding: 0.8rem 0.25rem;
    font-size: 0.95rem;
  }

  .facts div:last-child {
    border-bottom: 0;
  }

  .facts dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .facts dt :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--emerald-600);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .facts dd.missing {
    color: var(--muted);
    font-weight: 400;
  }

  .related {
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .related-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1rem 1.1rem;
    text-decoration: none;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }

  .related-card:hover {
    border-color: color-mix(in oklab, var(--emerald-600) 40%, var(--line));
    box-shadow: var(--shadow-lift);
  }

  .related-card > span:last-child {
    display: grid;
    gap: 0.15rem;
  }

  .related-name {
    font-family: var(--font-readex), system-ui, sans-serif;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
</style>
