---
import { ArrowRight, Info } from '@lucide/astro'
import { monogram, type Institution } from '@/lib/institutions'
import { getContext } from '@/lib/context'
import { localePath, useTranslations, type Locale } from '@/i18n'

interface Props {
  institutions: Institution[]
  lang: Locale
}

/**
 * Fields each Bac series usually leads to. Derived from the ministry's orientation rules
 * summarised in context.json (admissions.bacSeries.typicalPaths); guidance, not a rule.
 */
const SERIES_FIELDS: Record<string, string[]> = {
  C: ['Engineering', 'Computer Science', 'Sciences', 'Medicine', 'Economics', 'Business', 'Statistics', 'Mining', 'Energy'],
  D: ['Medicine', 'Health', 'Sciences', 'Agriculture', 'Engineering', 'Business', 'Maritime'],
  TMGM: ['Engineering', 'Energy', 'Mining', 'Computer Science'],
  LM: ['Humanities', 'Languages', 'Law', 'Economics', 'Journalism', 'Education', 'Public Administration', 'Business'],
  LO: ['Islamic Studies', 'Law', 'Humanities', 'Education', 'Languages'],
}

const { institutions, lang } = Astro.props
const { t, term, city } = useTranslations(lang)
const series = getContext(lang).admissions.bacSeries.filter((s) => SERIES_FIELDS[s.code])
const present = new Set(institutions.flatMap((e) => e.data.fields))
const seriesFields = Object.fromEntries(
  Object.entries(SERIES_FIELDS).map(([code, fields]) => [code, fields.filter((f) => present.has(f))]),
)
const allFields = [...new Set(Object.values(seriesFields).flat())]
---

<section
  id="orientation"
  class="pathfinder"
  aria-labelledby="path-title"
  data-pathfinder
  data-series-fields={JSON.stringify(seriesFields)}
  data-t-matches={t('path.matches')}
  data-directory={localePath(lang, '/')}
>
  <div class="wrap py-16 md:py-20">
    <div class="head">
      <h2 id="path-title" class="headline text-3xl md:text-[2.4rem]">{t('path.title')}</h2>
      <p class="mt-3 text-muted">{t('path.intro')}</p>
    </div>

    <fieldset class="series">
      <legend class="visually-hidden">{t('path.series')}</legend>
      {
        series.map((s) => (
          <label class="series-option">
            <input type="radio" name="series" value={s.code} />
            <span class="series-card">
              <span class="series-code" dir="ltr">{s.code}</span>
              <span class="series-name">{s.name}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <div class="result card" data-result hidden>
      <div class="result-head">
        <p class="label">{t('path.fields')}</p>
        <div class="fields" role="group" aria-label={t('path.fields')}>
          <button type="button" class="field-chip" data-field="" aria-pressed="true">{t('path.allFields')}</button>
          {allFields.map((f) => (
            <button type="button" class="field-chip" data-field={f} aria-pressed="false" hidden>
              {term(f)}
            </button>
          ))}
        </div>
        <p class="paths" data-paths></p>
      </div>

      <div class="matches-head">
        <p class="matches" data-matches aria-live="polite"></p>
        <a class="link inline-flex items-center gap-1 text-sm" href={localePath(lang, '/#directory')} data-directory-link>
          {t('path.directory')}
          <ArrowRight class="icon flip-rtl" aria-hidden="true" />
        </a>
      </div>

      <ul class="mini-list">
        {
          institutions.map((e) => (
            <li data-fields={e.data.fields.join('|')} hidden>
              <a href={localePath(lang, `/universities/${e.id}/`)} class="mini">
                <span class:list={['mini-mono', e.data.type]} aria-hidden="true">{monogram(e)}</span>
                <span class="min-w-0">
                  <span class="mini-name">{lang === 'ar' && e.data.nameAr ? e.data.nameAr : e.data.name}</span>
                  <span class="mini-meta">{city(e.data.city)}, {t(`type.${e.data.type}`)}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="note">
        <Info class="icon" aria-hidden="true" />
        {t('path.note')}
      </p>
    </div>

    <p class="empty" data-empty>{t('path.empty')}</p>

    {series.map((s) => <template data-paths-for={s.code}>{s.typicalPaths}</template>)}
  </div>
</section>

<style>
  .pathfinder {
    background: var(--mint);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .series {
    margin: 2.25rem auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 0.75rem;
    max-width: 60rem;
    border: 0;
    padding: 0;
  }

  .series-option input {
    position: absolute;
    opacity: 0;
  }

  .series-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: #fff;
    padding: 1rem 0.75rem;
    text-align: center;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .series-card:hover {
    border-color: var(--emerald-600);
  }

  .series-code {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--emerald-50);
    padding-inline: 0.5rem;
    font-weight: 600;
    color: var(--emerald-700);
  }

  .series-name {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
  }

  .series-option input:checked + .series-card {
    border-color: var(--ink);
    background: var(--ink);
  }

  .series-option input:checked + .series-card .series-code {
    background: rgb(255 255 255 / 14%);
    color: #fff;
  }

  .series-option input:checked + .series-card .series-name {
    color: #fff;
  }

  .series-option input:focus-visible + .series-card {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .result {
    margin: 1.5rem auto 0;
    max-width: 60rem;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .result {
      padding: 2rem;
    }
  }

  .label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .fields {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .field-chip {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    padding: 0.35rem 0.85rem;
    font: inherit;
    font-size: 0.88rem;
    color: var(--text);
    cursor: pointer;
  }

  .field-chip:hover {
    border-color: var(--emerald-600);
  }

  .field-chip[aria-pressed='true'] {
    border-color: var(--emerald-700);
    background: var(--emerald-700);
    color: #fff;
  }

  .paths {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .matches-head {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .matches {
    font-weight: 600;
    color: var(--ink);
  }

  .mini-list {
    margin-top: 1rem;
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 640px) {
    .mini-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .mini-list {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .mini {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.65rem 0.8rem;
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .mini:hover {
    border-color: var(--emerald-600);
  }

  .mini-mono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    min-width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    padding-inline: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    direction: ltr;
  }

  .mini-mono.public {
    background: var(--emerald-50);
    color: var(--emerald-700);
  }

  .mini-mono.private {
    background: var(--gold-50);
    color: var(--gold-700);
  }

  .mini > span:last-child {
    display: grid;
  }

  .mini-name {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .mini-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .note {
    margin-top: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .note :global(.icon) {
    margin-top: 0.15rem;
    color: var(--emerald-600);
  }

  .empty {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pathfinder]')!
  const seriesFields: Record<string, string[]> = JSON.parse(root.dataset.seriesFields!)
  const result = root.querySelector<HTMLElement>('[data-result]')!
  const empty = root.querySelector<HTMLElement>('[data-empty]')!
  const chips = [...root.querySelectorAll<HTMLButtonElement>('.field-chip')]
  const items = [...root.querySelectorAll<HTMLLIElement>('.mini-list li')]
  const matches = root.querySelector<HTMLElement>('[data-matches]')!
  const paths = root.querySelector<HTMLElement>('[data-paths]')!
  const directoryLink = root.querySelector<HTMLAnchorElement>('[data-directory-link]')!
  let series = ''
  let field = ''

  function render() {
    const fields = seriesFields[series] ?? []
    result.hidden = !series
    empty.hidden = Boolean(series)
    if (!series) return

    for (const chip of chips) {
      const f = chip.dataset.field!
      chip.hidden = f !== '' && !fields.includes(f)
      chip.setAttribute('aria-pressed', String(f === field))
    }

    const wanted = field ? [field] : fields
    let count = 0
    for (const item of items) {
      const show = item.dataset.fields!.split('|').some((f) => wanted.includes(f))
      item.hidden = !show
      if (show) count++
    }

    matches.textContent = root.dataset.tMatches!.replace('{count}', String(count))
    paths.textContent = root.querySelector<HTMLTemplateElement>(`[data-paths-for="${series}"]`)?.content.textContent ?? ''
    directoryLink.href = `${root.dataset.directory}${field ? `?field=${encodeURIComponent(field)}` : ''}#directory`
  }

  root.querySelectorAll<HTMLInputElement>('input[name="series"]').forEach((input) =>
    input.addEventListener('change', () => {
      series = input.value
      field = ''
      render()
    }),
  )

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      field = chip.dataset.field!
      render()
    }),
  )
</script>
