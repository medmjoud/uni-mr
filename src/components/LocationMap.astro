---
import { useTranslations, type Locale } from '@/i18n'

interface Props {
  name: string
  coordinates: [number, number]
  precision: 'campus' | 'city'
  lang: Locale
}

const { name, coordinates, precision, lang } = Astro.props
const { t } = useTranslations(lang)
const [lat, lng] = coordinates
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=${precision === 'campus' ? 16 : 12}/${lat}/${lng}`
---

<div class="location">
  <div
    class="location-map"
    data-location-map
    data-lat={lat}
    data-lng={lng}
    data-zoom={precision === 'campus' ? 15 : 11}
    data-name={name}
    dir="ltr"
    role="img"
    aria-label={t('profile.mapAria', { name })}
  >
  </div>
  <p class="location-note">
    {precision === 'campus' ? t('profile.mapCampus') : t('profile.mapCity')}{' '}
    <a class="link" href={osm}>{t('profile.openMap')}</a>
  </p>
</div>

<style>
  .location-map {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background: var(--emerald-50);
    overflow: hidden;
    isolation: isolate;
  }

  .location-note {
    margin-top: 0.6rem;
    padding-inline: 0.35rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .location-map :global(.pin) {
    width: 18px;
    height: 18px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #2f7a45;
    box-shadow: 0 2px 6px rgb(0 0 0 / 35%);
  }
</style>

<script>
  // Load Leaflet only when the map scrolls into view.
  const maps = document.querySelectorAll<HTMLElement>('[data-location-map]')
  const observer = new IntersectionObserver(async (entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue
      observer.unobserve(entry.target)
      const el = entry.target as HTMLElement
      const [{ default: L }] = await Promise.all([
        import('leaflet'),
        import('leaflet/dist/leaflet.css'),
      ])
      const center: [number, number] = [Number(el.dataset.lat), Number(el.dataset.lng)]
      const map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView(
        center,
        Number(el.dataset.zoom),
      )
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map)
      L.marker(center, {
        icon: L.divIcon({ className: 'pin', iconSize: [18, 18] }),
        title: el.dataset.name,
      }).addTo(map)
    }
  }, { rootMargin: '200px' })

  maps.forEach((m) => observer.observe(m))
</script>
