---
import { Image } from 'astro:assets'
import { monogram, type Institution } from '@/lib/institutions'
import { logoFor } from '@/lib/media'

interface Props {
  entry: Institution
  /** xs: Bac finder list, sm: related cards, md: directory cards, lg: profile header. */
  size?: 'xs' | 'sm' | 'md' | 'lg'
}

const { entry, size = 'md' } = Astro.props
const logo = logoFor(entry.id)
const px = { xs: 38, sm: 44, md: 48, lg: 68 }[size]
---

{
  logo ? (
    <span class:list={['mark', size, 'logo']} aria-hidden="true">
      <Image src={logo.image} alt="" width={px} height={px} densities={[1, 2]} loading="lazy" />
    </span>
  ) : (
    <span class:list={['mark', size, entry.data.type]} aria-hidden="true">
      {monogram(entry)}
    </span>
  )
}

<style>
  .mark {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    font-family: var(--font-readex), system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    direction: ltr;
  }

  .xs {
    min-width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    padding-inline: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .sm {
    min-width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    padding-inline: 0.5rem;
    font-size: 0.8rem;
  }

  .md {
    min-width: 3rem;
    height: 3rem;
    border-radius: 12px;
    padding-inline: 0.55rem;
    font-size: 0.9rem;
  }

  .lg {
    min-width: 4.25rem;
    height: 4.25rem;
    border-radius: 16px;
    padding-inline: 0.7rem;
    font-size: 1.1rem;
  }

  .public {
    background: var(--emerald-50);
    color: var(--emerald-700);
  }

  .private {
    background: var(--gold-50);
    color: var(--gold-700);
  }

  /* The profile header sits on a pale green band, so its public badge needs its own fill. */
  .lg.public {
    background: #fff;
    border: 1px solid var(--emerald-100);
  }

  /* Logos are drawn for white backgrounds, so the tile stays white with a hairline edge. */
  .logo {
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--line);
  }

  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
