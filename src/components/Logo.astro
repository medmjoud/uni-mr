---
import { BRAND_GOLD, BRAND_GREEN, DOOR_PATH, STEP_RECT } from '@/lib/brand'
import type { Locale } from '@/i18n'

interface Props {
  lang: Locale
  inverted?: boolean
}
const { lang, inverted = false } = Astro.props
---

<!-- The doorway mark beside the name: two lines in French and English, one in Arabic. -->
<span class:list={['logo', { inverted }]}>
  <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
    <rect width="100" height="100" rx="24" fill={BRAND_GREEN}></rect>
    <path d={DOOR_PATH} fill={BRAND_GOLD}></path>
    <rect {...STEP_RECT} fill={BRAND_GOLD}></rect>
  </svg>
  {
    lang === 'ar' ? (
      <span class="name name-ar">
        <span>جامعات</span> <span>موريتانيا</span>
      </span>
    ) : (
      <span class="name" lang="fr">
        <span>Universités</span>
        <span>de Mauritanie</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .mark {
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
  }

  .name {
    display: flex;
    flex-direction: column;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.08;
  }

  .name-ar {
    flex-direction: row;
    gap: 0.3em;
    font-size: 1.2rem;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* One line is too wide beside the phone header's buttons, so stack it like the French name. */
  @media (max-width: 480px) {
    .name-ar {
      flex-direction: column;
      gap: 0;
      font-size: 1.05rem;
      line-height: 1.15;
    }
  }

  .inverted {
    color: #fff;
  }
</style>
